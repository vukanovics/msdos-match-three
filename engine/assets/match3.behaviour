# Match-three behaviour.
#
# Total and non-recursive: definitions are inlined by the compiler and 'for' is a
# counted loop, so there is no recursion and every program terminates. State
# lives in the scene's slot table; @name reads a slot and !name writes one, while
# bare '@' and '!' take the slot index from the stack and '&name' pushes it.
#
# The engine knows nothing about boards: it has an entity pool, and each entity
# is a sprite, an x, a y, a flag word and the tick its animation began.
# Everything below - the grid, the cursor, the falling, the glimmer - is built
# from that.
#
#   entity 0..99   board cells, row * 10 + column
#   entity 100     cursor box
#   entity 101     picked tile box
#
# A cell's resting position comes from its own index, so a tile that is falling
# only needs its current y: the entity drifts back towards row * cell. Because
# of that, a cell's y is not always row * cell - mid-animation it is wherever
# the tile it holds really is.
#
# Positions are Q16.16, so a pixel is written as (pixels * 65536).
#
# Animations are not part of the world: the engine derives the cel from the tick
# an animation began and the frame counter. So "play this animation now" is
# "write the current tick", and the only animation state in the slot table is
# that start tick. That is also why the clock below has to live in the state.

# 24 * 65536, one cell in fixed point.
def cell
  1572864
end

# 40 * 65536: where the board starts horizontally.
def origin-x
  2621440
end

# Acceleration, Q16.16 pixels per tick per tick. 1500 px/s^2 over 1/60 s ticks is
# 0.4167 px/tick^2, so a tile falls the height of the board in about half a
# second, which is the pace the original game was tuned to.
def gravity
  27307
end

# One cell per ten ticks, so a swap takes a sixth of a second.
def swap-step
  157286
end

# Land a freshly spawned tile one whole board above its row.
def above-board
  15728640
end

# Slots per entity. This is ENTITY_STRIDE in the engine, and the behaviour has
# to agree with it because it addresses the pool arithmetically.
def stride
  5
end

# The offset of the animation start within an entity's slots.
def anim
  4
end

# Slot base of the two box entities (100 and 101), which the behaviour owns.
def cursor-base
  500
end

def picked-base
  505
end

# Ticks a cel is held for. Must match animation.ticks in the scene, which the
# behaviour compiler does not read.
def ticks
  4
end

# Ticks one glimmer lasts: the whole glimmer animation, played once.
def glimmer-length
  240
end

# Ticks between rolls, at least this many plus the spread. Shorter than a glimmer,
# so runs overlap and two gems of a kind can be glimmering at once.
def glimmer-gap
  60
end

def glimmer-gap-spread
  120
end

# 6 + kind: the idle sprites are handles 6..11, and glimmer0..5 are handles 0..5,
# so a gem's kind is its idle handle less six and its glimmer handle less six
# again.
def idle-base
  6
end

# Slot index of the velocity array, so it can be indexed at run time.
def vel-base
  &velocity0
end

# The same for the glimmer pool. Its size is fixed by the scene; every 'for 4'
# and the '3' that counts down through it below have to agree with it.
def glimmer-base
  &glimmer-cell0
end

# Slot base of the board cell at (row, column) on the stack.
def at
  swap 10 * + stride *
end

# |x|
def abs
  dup 0 < [ neg ] when
end

# Cels in one idle animation.
def idle-frames
  60
end

# Spacing between neighbours' phases, in cels. Anything coprime with the loop
# length walks every phase before repeating, and a stride like this scatters
# them: neighbouring cells land far apart in the animation instead of forming a
# ripple across the board.
def phase-stride
  37
end

# Give entity i an animation start such that its idle animation is part way
# through, offset by its own cell. Every gem therefore animates on its own
# timing rather than in step with the rest.
def setIdlePhase
  dup phase-stride * idle-frames mod ticks * neg over stride * anim + !
end

# Turn entity i's sprite into its glimmer sprite and start the glimmer now.
#
# Only an idle gem converts. A cell rolled for twice by accident keeps the run it
# already has, rather than stepping its handle twice into nothing.
def setGlimmer
  dup stride * @                          # i, sprite
  dup idle-base >=
  [ idle-base - over stride * !
    @time over stride * anim + ! ]
  [ drop ]
  ifelse
end

# Turn a glimmering entity's sprite back into idle, on its own phase. Doing this
# to a gem that is already idle is harmless, which is what makes stopping the
# pool twice safe.
def setIdle
  dup stride * @                          # i, sprite
  dup 0 >= over idle-base < and
  [ idle-base + over stride * ! ]
  [ drop ]
  ifelse
  setIdlePhase
end

# Stop every running glimmer.
#
# A glimmer is only ever alive while the board is quiet. Anything that reads
# sprite handles to decide something - matching, swapping - would otherwise see
# a gem wearing a different sprite than its kind, so every transition out of the
# quiet state stops the pool first.
def glimmer-stop
  for 4 [
    dup @glimmer-count <
    [ dup glimmer-base + @ setIdle drop ] when
    drop
  ]
  0 !glimmer-count
end

# The tick entry j finishes on.
def glimmer-deadline                     # j -> deadline
  glimmer-base + @ stride * anim + @ glimmer-length +
end

# Drop entry j by moving the last one into its place. Leaves j on the stack.
def glimmer-remove                       # j -> j
  @glimmer-count 1 - !temp-c
  @temp-c glimmer-base + @ !temp-d
  @temp-d over glimmer-base + !
  @temp-c !glimmer-count
end

# End entry j if its animation has played out. Leaves j on the stack.
def glimmer-end-at                       # j -> j
  dup !temp-a
  @temp-a glimmer-base + @ !temp-b
  @temp-b 0 >=
  @temp-a glimmer-deadline @time <=
  and
  [ @temp-b setIdle drop
    @temp-a glimmer-remove drop ] when
end

# Retire the glimmers that have played out. Descending, because an entry moved
# down into a hole has already been looked at, so one pass settles the pool.
def glimmer-expire
  for 4 [
    3 swap -                             # j counts down 3..0
    dup @glimmer-count <
    [ glimmer-end-at ] when
    drop
  ]
end

# Roll for another glimmer while the pool has room and the wait is over.
def glimmer-roll
  @glimmer-count 4 <
  @time @next-roll >=
  and
  [ roll-glimmer ] when
end

def roll-glimmer
  random 100 mod !temp-a                  # temp-a is the cell
  @temp-a
  @glimmer-count glimmer-base +
  !                                       # the pool is not full, see above
  @glimmer-count 1 + !glimmer-count
  @temp-a setGlimmer drop
  @time glimmer-gap + random glimmer-gap-spread mod + !next-roll
end

# Move the cursor entity to the cell the cursor globals point at.
def place-cursor
  @cursor-column cell * origin-x +          # x
  @cursor-row cell *                      # x y
  cursor-base 2 + !                       # store y
  cursor-base 1 + !                       # store x
end

def move-up
  @cursor-row 1 - 0 max 9 min !cursor-row
end

def move-down
  @cursor-row 1 + 0 max 9 min !cursor-row
end

def move-left
  @cursor-column 1 - 0 max 9 min !cursor-column
end

def move-right
  @cursor-column 1 + 0 max 9 min !cursor-column
end

# Show the picked box on the cursor cell and remember where that was.
def pick
  @cursor-row !picked-row
  @cursor-column !picked-column
  @cursor-column cell * origin-x +          # x
  @cursor-row cell *                      # x y
  picked-base 2 + !                       # store y
  picked-base 1 + !                       # store x
  1 picked-base 3 + !                     # visible
end

def unpick
  -1 !picked-row
  -1 !picked-column
  0 picked-base 3 + !                     # hidden
end

# Exchange the sprites and animation starts of the picked and cursor cells. The
# values are read into temp slots first, because both writes need both reads.
#
# The animation goes with the gem, not with the cell: gems of one kind are all on
# the same cel, which is what lets the renderer keep them in its cel cache.
def swap-tiles
  @cursor-row @cursor-column at !temp-a           # slot base of the cursor cell
  @picked-row @picked-column at !temp-b           # slot base of the picked cell
  @temp-a @ !temp-c
  @temp-b @ !temp-d
  @temp-c @temp-b !
  @temp-d @temp-a !
  @temp-a anim + @ !temp-c
  @temp-b anim + @ !temp-d
  @temp-c @temp-b anim + !
  @temp-d @temp-a anim + !
end

# Only neighbours may be swapped.
def adjacent
  @picked-row @cursor-row - abs
  @picked-column @cursor-column - abs
  + 1 =
end

# Slide the two cells towards each other; the sprites change hands at the end.
#
# The glimmer is stopped first, so the handles this reads are idle ones and the
# gem does not carry a half-played glimmer to its new cell.
def swap-start
  glimmer-stop
  @cursor-row @cursor-column at !temp-a
  @picked-row @picked-column at !temp-b
  @picked-column @cursor-column - swap-step * !step-x
  @picked-row @cursor-row - swap-step * !step-y
  0 picked-base 3 + !                     # hide the picked box while it slides
  10 !timer
  1 !phase
end

def swap-tick
  @temp-a 1 + @ @step-x + @temp-a 1 + !
  @temp-a 2 + @ @step-y + @temp-a 2 + !
  0 @step-x - @temp-b 1 + @ + @temp-b 1 + !
  0 @step-y - @temp-b 2 + @ + @temp-b 2 + !
  @timer 1 - !timer
  @timer 0 <= [ swap-finish ] when
end

def swap-finish
  @cursor-column cell * origin-x + @temp-a 1 + !
  @cursor-row cell * @temp-a 2 + !
  @picked-column cell * origin-x + @temp-b 1 + !
  @picked-row cell * @temp-b 2 + !
  swap-tiles
  unpick
  1 !dirty
  0 !phase
end

# If the three cells starting at i, stepping by s *slots*, hold the same tile,
# mark all three. Leaves i on the stack so the caller can go on using it.
#
# i is an entity index, so its sprite is at slot i * stride; s is already a slot
# stride (stride across, ten strides down) because that is what is added to it.
def mark3
  !temp-b                                 # temp-b is the slot stride
  dup stride * !temp-d                    # temp-d is the slot base of i
  @temp-d @ !temp-a                       # temp-a is the tile
  @temp-d @temp-b + @ @temp-a =           # i a
  @temp-d 2 @temp-b * + @ @temp-a =       # i a b
  and @temp-a 0 >= and                    # i matched
  [
    3 @temp-d 3 + !
    3 @temp-d @temp-b + 3 + !
    3 @temp-d 2 @temp-b * + 3 + !
    1 !matches
  ] when
end

# A cell that is part of a run has flags 3: visible, and marked.
def match-pass
  0 !matches
  for 100 [
    dup 10 mod 8 < [ stride mark3 ] when
    dup 10 / 8 < [ 10 stride * mark3 ] when
    drop
  ]
end

# Hide every marked cell.
def clear-pass
  for 100 [
    dup stride * 3 + @ 3 =
    [
      -1 over stride * !
      1 over stride * 3 + !
    ] when
    drop
  ]
end

# Move the tile above an empty cell down into it, remembering where it came from
# so the fall animates from there. The animation start travels with the gem, for
# the same reason it does in a swap.
def pull-down
  dup 10 - !temp-a                        # temp-a is the cell above
  vel-base over + !temp-d                 # temp-d is velocity[i]
  @temp-a stride * @ over stride * !      # sprite
  @temp-a stride * anim + @ over stride * anim + !  # animation
  @temp-a stride * 2 + @ over stride * 2 + !        # y
  vel-base @temp-a + @ !temp-c            # temp-c is velocity[i - 10]
  @temp-c @temp-d !
  0 vel-base @temp-a + !
  -1 @temp-a stride * !                   # the tile left its old cell
end

# Ten passes is enough to settle a ten row column completely.
def collapse-pass
  for 10 [
    for 100 [
      dup 10 >= [
        dup stride * @ 0 <
        over 10 - stride * @ 0 >=
        and
        [ pull-down ] when
      ] when
      drop
    ]
    drop
  ]
end

# New tiles enter from above the board, keeping their spacing, so a refilled
# column reads as one stack falling in.
def refill-pass
  for 100 [
    dup stride * @ 0 <
    [
      random 6 mod idle-base + over stride * !     # a new kind, idle
      setIdlePhase
      dup 10 / cell * above-board - over stride * 2 + !
      vel-base over + !temp-d
      0 @temp-d !
      1 over stride * 3 + !
    ] when
    drop
  ]
end

# One tick of gravity for one cell. Leaves i on the stack.
def fall-entity
  dup 10 / cell * !temp-b                 # temp-b is where it comes to rest
  vel-base over + !temp-d                 # temp-d is velocity[i]
  dup stride * 2 + @ !temp-c              # temp-c is y
  @temp-c @temp-b < [
    @temp-d @ gravity + @temp-d !
    @temp-c @temp-d @ + !temp-c
    @temp-c @temp-b >= [
      @temp-b !temp-c
      0 @temp-d !
    ] when
    1 !moving
  ] when
  @temp-c over stride * 2 + !
end

def fall-tick
  0 !moving
  for 100 [ fall-entity drop ]
  @moving 0 = [ 0 !phase 1 !dirty ] when
end

def clear-tick
  @timer 1 - !timer
  @timer 0 <= [
    clear-pass
    collapse-pass
    refill-pass
    3 !phase
  ] when
end

def idle-tick
  @dirty 0 >
  [
    match-pass
    0 !dirty
    @matches 0 > [ 8 !timer 2 !phase ] when
  ] when
end

def tick
  @time 1 + !time
  # The glimmer is cosmetic, so the pool is simply emptied while anything else is
  # going on: quiet means idle and already matched.
  @phase 0 =
  @dirty 0 =
  and
    [ glimmer-expire glimmer-roll ]
    [ glimmer-stop ]
  ifelse
  @phase 0 = [ idle-tick ] when
  @phase 1 = [ swap-tick ] when
  @phase 2 = [ clear-tick ] when
  @phase 3 = [ fall-tick ] when
end

# Build the world: lay out the board, then put the boxes in place. Called once.
#
# The index of each cell is pushed by 'for'; the body leaves nothing behind.
def init
  for 100 [
    random 6 mod idle-base + over stride * !             # sprite
    setIdlePhase
    dup 10 mod cell * origin-x + over stride * 1 + !     # x
    dup 10 / cell * over stride * 2 + !                 # y
    1 over stride * 3 + !                               # visible
    drop
  ]
  $cursor cursor-base !         # cursor sprite
  $picked picked-base !         # picked sprite
  1 cursor-base 3 + !           # cursor visible
  place-cursor
end

# Keys arrive as BIOS scan codes for the arrows and 13 for return. `dup 72 =`
# consumes the copy, so the key stays on the stack for the remaining tests and
# the quotations must leave it alone; the final drop removes it.
#
# Input is ignored while the board is animating, so a key cannot land in the
# middle of a swap or a cascade.
def on-key
  @phase 0 = [
    dup 72 = [ move-up ] when
    dup 80 = [ move-down ] when
    dup 75 = [ move-left ] when
    dup 77 = [ move-right ] when
    dup 13 = [ toggle-pick ] when
    drop
    place-cursor
  ] [ drop ] ifelse
end

# Return picks a tile; return on a neighbour starts the swap, and on anything
# else moves the pick instead of clearing it.
def toggle-pick
  @picked-row 0 <
    [ pick ]
    [ adjacent [ swap-start ] [ pick ] ifelse ]
  ifelse
end
