# Match-three scene.
#
# Parsed when the scene loads. Every non-blank line is "key value"; anything
# after '#' is a comment. Unknown keys fail at load time.
#
# The scene is the single source of truth for the world: the engine reads it,
# the behaviour compiler reads it, and the compiled slot count is checked
# against it at load.

scene.name match3

# Sprite sheets on disk, written by tools/build_gems.py. The count is declared
# here so the behaviour compiler can hand every sprite a number without reading
# the art; the loader checks each file against it.
sheet blue BLUE.SPR 120
sheet cyan CYAN.SPR 120
sheet green GREEN.SPR 120
sheet purple PURPLE.SPR 120
sheet red RED.SPR 120
sheet yellow YELLOW.SPR 120
sheet ui UI.SPR 2

# Named sprites. The behaviour program refers to these as $name, and the handle
# is the sprite's position here, in declaration order. The third number is the
# first cel.
#
# 'sprite' is a single cel. 'animatedsprite' is a run of them: the fourth number
# is how many cels it holds and the fifth how many ticks each is held for, so
# every run has its own speed. 'loop' wraps back to the first cel instead of
# stopping on the last one and telling the behaviour, and 'resident' decodes the
# whole run up front and keeps it.
#
# Residency is what makes a hundred gems at a hundred cels affordable: every gem
# is on its own cel, so without it each frame would decode a hundred of them, at
# about a third of a millisecond each.
#
# Each sheet holds 60 cels of glimmer followed by 60 of idle. The order here
# matters: the behaviour relies on glimmer N being handle N and idle N being
# handle N + 6, so it can tell them apart with a single comparison and recover a
# gem's kind with arithmetic on the handle.
#
# Both runs animate the jewel over a fixed, unlit mount.
animatedsprite glimmer0 blue 0 60 4
animatedsprite glimmer1 cyan 0 60 4
animatedsprite glimmer2 green 0 60 4
animatedsprite glimmer3 purple 0 60 4
animatedsprite glimmer4 red 0 60 4
animatedsprite glimmer5 yellow 0 60 4
animatedsprite idle0 blue 60 60 4 loop resident
animatedsprite idle1 cyan 60 60 4 loop resident
animatedsprite idle2 green 60 60 4 loop resident
animatedsprite idle3 purple 60 60 4 loop resident
animatedsprite idle4 red 60 60 4 loop resident
animatedsprite idle5 yellow 60 60 4 loop resident
sprite cursor ui 0
sprite picked ui 1

entities.count 104

color.background 253

world.seed 4231

# Burst ranges are inclusive. Origins are percentages of the sprite extent.
# Velocities are in sixteenths of a pixel per tick, with negative Y upwards.
# Size is in pixels, lifetime in simulation ticks, and colour in palette indices.
particles.count 24 32
particles.x 0 100
particles.y 0 100
particles.vx -36 36
particles.vy -24 32
# Downward acceleration in 1/256 pixel per tick squared.
particles.gravity 56
# The upper palette indices are reserved for the board and cursor.
particles.colour 0 252
particles.size 2 5
particles.lifetime 15 27

# Named globals. These follow the entity pool, in this order, and are what the
# behaviour program names with '@name' and '!name'.
slot cursor-row 5
slot cursor-column 5
slot picked-row -1
slot picked-column -1

# Scratch shared by the behaviour's helper definitions.
slot temp-a 0
slot temp-b 0
slot temp-c 0
slot temp-d 0
slot collapse-destination 0

# The state machine: 0 idle, 1 swapping, 2 clearing, 3 falling.
slot phase 0
slot timer 0
slot step-x 0
slot step-y 0
# The two cells being swapped. These outlive the tick that started the swap, so
# they cannot live in the temp slots: anything else that runs in between - a
# glimmer roll, an animation ending - would overwrite them.
slot swap-a 0
slot swap-b 0
slot moving 0
slot matches 0

# Set when the board may contain a run; cleared once it has been scanned. While
# it is clear the idle tick costs nothing, which is most of the time.
slot dirty 1

# Per-entity state the behaviour program keeps for itself. The engine has no
# idea these exist; they are just more slots after the entity pool.
#   kindN         which gem entity N holds, 0..5; what matching compares
#   velocityN     how many Q16.16 pixels entity N is falling this tick
array kind 104 0
array velocity 104 0

# Ticks since the program started, so a glimmer can be scheduled.
slot time 0
# The tick at which the next glimmer is rolled for.
slot next-roll 0
